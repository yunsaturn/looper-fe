# ─────────────────────────────────────────────────────────────
#  Looper FE 환경변수
#  이 파일을 .env 로 복사해서 사용하세요. (.env 는 커밋되지 않습니다)
#  기획서 R6 대응: API 키와 비밀값은 코드에 노출하지 않습니다.
# ─────────────────────────────────────────────────────────────

# Spring Boot API 서버 주소
# 프론트는 이 주소로만 통신합니다. FastAPI(AI 서비스)는 Private 이므로
# 절대 프론트에서 직접 호출하지 않습니다.
VITE_API_BASE_URL=http://localhost:8080

# MSW 목업 서버 사용 여부
# true  — BE 없이 시드 데이터로 전체 화면을 개발/시연할 때
# false — 실제 Spring Boot 서버에 붙을 때
VITE_USE_MOCK=true

# ─────────────────────────────────────────────────────────────
#  배포 (Vercel) 주의사항
# ─────────────────────────────────────────────────────────────
#  VITE_ 로 시작하는 값은 **빌드 시점에 코드에 박힙니다.**
#  런타임에 바뀌지 않으므로, 값을 고치면 반드시 재배포해야 합니다.
#
#  Vercel 대시보드 → Settings → Environment Variables 에
#  아래 두 개를 등록하세요.
#
#    VITE_API_BASE_URL = https://(BE Render 주소)
#    VITE_USE_MOCK     = false
#
#  BE 가 아직 안 떴다면 VITE_USE_MOCK=true 로 먼저 배포해서
#  FE 주소를 확보한 뒤, 그 주소를 BE 의 CORS_ALLOWED_ORIGINS 에
#  넣어달라고 요청하고, 나중에 false 로 바꿔 재배포하면 됩니다.
