# ─────────────────────────────────────────────────────────────
#  Looper FE 환경변수
#  이 파일을 .env 로 복사해서 사용하세요. (.env 는 커밋되지 않습니다)
#  기획서 R6 대응: API 키와 비밀값은 코드에 노출하지 않습니다.
# ─────────────────────────────────────────────────────────────

# Spring Boot API 서버 주소
# 프론트는 이 주소로만 통신합니다. FastAPI(AI 서비스)는 Private 이므로
# 절대 프론트에서 직접 호출하지 않습니다.
VITE_API_BASE_URL=http://localhost:8080

# MSW 목업 서버 사용 여부
# true  — BE 없이 시드 데이터로 전체 화면을 개발/시연할 때
# false — 실제 Spring Boot 서버에 붙을 때
VITE_USE_MOCK=true
