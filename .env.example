# ─────────────────────────────────────────────────────────────
#  Looper FE 환경변수
#  이 파일을 .env 로 복사해서 쓰세요. (.env 는 커밋되지 않습니다)
#  기획서 R6 대응: API 키와 비밀값은 코드에 노출하지 않습니다.
#
#      cp .env.example .env && npm install && npm run dev
#
#  ⚠️ VITE_ 값은 **빌드 시점에 코드에 박힙니다.**
#     .env 를 고쳤으면 dev 서버를 껐다 켜야 반영됩니다.
# ─────────────────────────────────────────────────────────────

# ── 실행 모드 ────────────────────────────────────────────────
# true  — MSW 목업. BE 없이 시드 데이터로 전체 화면이 돌아갑니다.
#         로그인은 아무 값으로나 됩니다(데모 계정이 미리 채워져 있음).
# false — 실제 Spring Boot 서버에 붙습니다. 아래 CORS 항목을 꼭 읽으세요.
VITE_USE_MOCK=true

# ── API 서버 주소 ────────────────────────────────────────────
# 프론트는 이 주소로만 통신합니다. FastAPI(AI 서비스)는 Private 이므로
# 절대 프론트에서 직접 호출하지 않습니다.
#
# 도메인만 넣어도 되고 BE 가 알려준 /api/v1 형태를 그대로 넣어도 됩니다.
# 코드가 뒤쪽 /api/v1 을 떼어내므로 경로가 중복되지 않습니다.
VITE_API_BASE_URL=https://be-andh.onrender.com

# ─────────────────────────────────────────────────────────────
#  로컬에서 실제 서버에 붙으려면 (VITE_USE_MOCK=false)
# ─────────────────────────────────────────────────────────────
#  BE 의 CORS 허용 목록에 로컬 주소가 들어 있어야 합니다.
#  Render 환경변수 CORS_ALLOWED_ORIGINS 는 기본값을 **덮어쓰기** 때문에,
#  배포 주소만 넣어두면 로컬(5173)은 차단됩니다.
#
#    CORS_ALLOWED_ORIGINS=https://fe-vlak.vercel.app,http://localhost:5173
#
#  로그인 버튼을 눌렀는데 아무 반응이 없고 개발자도구 콘솔에
#  "CORS" 또는 "Access-Control-Allow-Origin" 문구가 보이면 이 문제입니다.
#  (Network 탭에서 OPTIONS 요청이 실패한 것으로 보입니다)
#
#  로컬에서 BE 를 직접 띄웠다면 위 주소 대신 아래를 쓰세요.
#    VITE_API_BASE_URL=http://localhost:8080
#
# ─────────────────────────────────────────────────────────────
#  배포 (Vercel)
# ─────────────────────────────────────────────────────────────
#  Vercel 대시보드 → Settings → Environment Variables 에 등록합니다.
#
#    VITE_API_BASE_URL = https://be-andh.onrender.com
#    VITE_USE_MOCK     = false
#
#  값을 고치면 런타임에 바뀌지 않으므로 반드시 재배포하세요.
