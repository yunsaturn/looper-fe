{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "rewrites": [
    {
      "comment": "SPA 폴백 — /trades/trade-1 같은 주소로 직접 들어와도 index.html 을 준다. 정적 파일(assets, mockServiceWorker.js)은 이 규칙보다 먼저 매칭되므로 영향받지 않는다.",
      "source": "/((?!assets/|mockServiceWorker\\.js).*)",
      "destination": "/index.html"
    }
  ],

  "headers": [
    {
      "comment": "서비스워커가 캐시되면 목업 토글이 즉시 반영되지 않는다",
      "source": "/mockServiceWorker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "comment": "해시가 붙은 번들은 영구 캐시해도 안전하다",
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
